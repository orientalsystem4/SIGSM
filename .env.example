DB_HOST=db
DB_NAME=sigsm
# Usuario de la aplicación web: solo lee y escribe datos, sin permisos de estructura
DB_USER=sigsm_app
# Generado por el instalador (bin/instalar.sh)
DB_PASS=

# Administrador de la base: estructura, seeder, crear_admin.php y respaldos.
# Si falta, los scripts usan DB_USER/DB_PASS (instalaciones anteriores).
DB_ADMIN_USER=sigsm_admin
# Generado por el instalador (bin/instalar.sh)
DB_ADMIN_PASS=

# Clave de root de MariaDB: solo para administrar el contenedor (no la usan la
# aplicación ni los scripts, salvo bin/usuarios_bd.sh). Generada por el instalador.
DB_ROOT_PASS=

# Credenciales de Semilla (Seeder CLI)
SEED_ADMIN_USER=admin
# Generado por el instalador (bin/instalar.sh)
SEED_ADMIN_PASS=

# Monitoreo (Cockpit): si se define, DTI ve la tarjeta "Monitoreo" en el panel de módulos.
# Tras cambiarla, aplicar con: docker compose up -d
# COCKPIT_URL=http://IP:9090
